rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getRole() == 'admin';
    }

    function isKitchen() {
      return isSignedIn() && (getRole() == 'kitchen' || getRole() == 'admin');
    }

    function isRider() {
      return isSignedIn() && (getRole() == 'rider' || getRole() == 'admin');
    }

    // ========================================
    // ORDERS — สร้างได้โดยทุกคน (customer), อ่าน/แก้ไขโดย staff
    // ========================================
    match /orders/{orderId} {
      allow create: if true;  // ลูกค้าสั่งอาหาร ไม่ต้อง login
      allow read:   if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ========================================
    // PUBLIC ORDERS — ลูกค้า track ได้ด้วย token (ไม่ต้อง login)
    // ========================================
    match /publicOrders/{token} {
      allow read:   if true;
      allow create: if true;
      // update ได้เฉพาะ field สถานะ และรูปจัดส่ง เท่านั้น
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'deliveryPhoto', 'deliveredAt', 'startedDeliveryAt']);
      allow delete: if isAdmin();
    }

    // ========================================
    // MENU — อ่านได้ทุกคน, แก้ไขเฉพาะ admin
    // ========================================
    match /menu/{itemId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ========================================
    // SETTINGS — อ่านได้ทุกคน (shop status), เขียนเฉพาะ admin
    // ========================================
    match /settings/{docId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ========================================
    // STAFF — อ่านได้เฉพาะ signed-in users (role check), เขียนเฉพาะ admin
    // ========================================
    match /staff/{uid} {
      allow read:   if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write:  if isAdmin();
    }
  }
}
